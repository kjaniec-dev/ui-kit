    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
