{
  "name": "kj-product-kit-starter",
  "version": "0.9.3",
  "private": true,
  "description": "Starter tokens and theme for KJ Product Kit.",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "tokens:check": "node -e \"JSON.parse(require('fs').readFileSync('./packages/design/tokens.json','utf8')); console.log('Tokens OK')\"",
    "storybook": "npm run storybook --workspace @kjaniec-dev/ui",
    "build-storybook": "npm run build-storybook --workspace @kjaniec-dev/ui",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run test --workspaces --if-present",
    "site:dev": "npm run dev --workspace @kjaniec-dev/site",
    "site:preview": "npm run preview --workspace @kjaniec-dev/site",
    "chromatic": "npx chromatic",
    "mcp:build": "npm run build --workspace @kjaniec-dev/ui-mcp",
    "mcp:dev": "npm run dev --workspace @kjaniec-dev/ui-mcp",
    "mcp:start": "node ./packages/mcp/dist/index.js",
    "mcp:test": "npm run test --workspace @kjaniec-dev/ui-mcp"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10"
  }
}
